{
  "name": "wookie-books",
  "version": "1.0.0",
  "private": true,
  "description": "Wookie Books - a self-publishing bookstore REST API (Node + Express + MongoDB).",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "capture:transcript": "node scripts/capture-transcript.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.1.4",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "js2xmlparser": "^5.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.2.4",
    "morgan": "^1.10.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/test/globalSetup.js",
    "globalTeardown": "<rootDir>/test/globalTeardown.js",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "dal/**/*.js",
      "middleware/**/*.js",
      "services/**/*.js",
      "utils/**/*.js"
    ]
  }
}
