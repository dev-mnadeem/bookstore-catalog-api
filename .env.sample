# Copy to .env and fill in. .env is git-ignored and must never be committed.

# development | test | production
ENVIRONMENT=development
SERVER_PORT=3000

# MongoDB connection string. Local: mongodb://127.0.0.1:27017/wookie-books
DATABASE_URL=mongodb://127.0.0.1:27017/wookie-books

# Signing key for issued JWTs. Generate your own, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=replace-me-with-a-long-random-value

# Optional — defaults shown.
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100
BANNED_AUTHOR_PSEUDONYMS=Darth Vader
